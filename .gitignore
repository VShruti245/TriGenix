# TriGenix — Git ignore rules

# ── User data (NEVER commit) ────────────────────────────────────────────────
generated/
uploads/
*.db
*.db-shm
*.db-wal

# ── Model weights (too large) ───────────────────────────────────────────────
weights/
*.ckpt
*.safetensors
*.pth
*.pt
*.bin

# ── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.local

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── Large media ──────────────────────────────────────────────────────────────
*.mp4
*.zip
*.tar.gz
*.log

# ── Kiro / IDE ────────────────────────────────────────────────────────────────
.kiro/
.agents/
.codex_build/
.codex_synopsis/
.codex-finalizer/
.vscode/
.idea/

# ── Research paper, poster, presentations (hide from repo) ───────────────────
paper/
docs/
poster_assets/
output/
*.pptx
*.docx
*.pdf
Plagiarism Report.*
plagiarism report/

# ── One-off build/temp scripts ────────────────────────────────────────────────
build_poster.py
build_final*.py
make_chart.py
make_composite.py
extract_images.py
inspect_*.py
update_poster.py
revise_trigenix_poster.py
create_trigenix_project_deck.py
patch_instantmesh.py
check.py
verify_fixes.py
diag*.py
fix_*.py
test_repaint.py
test2.py

# ── Misc ─────────────────────────────────────────────────────────────────────
directory.txt
.DS_Store
Thumbs.db
terminal_op.mp4
working.mp4
working_majorphase1.mp4
working.zip

# Git internal
.gitattributes
