# TriGenix environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8000

# Allowed CORS origins (comma-separated). Use * only for local development.
# Example: TRIGENIX_ALLOWED_ORIGINS=http://localhost:8000,https://yourdomain.com
TRIGENIX_ALLOWED_ORIGINS=http://localhost:8000

# ── Upload limits ─────────────────────────────────────────────────────────
TRIGENIX_MAX_UPLOAD_MB=15
TRIGENIX_JOB_TTL_SECONDS=21600

# ── Model warm-up ─────────────────────────────────────────────────────────
# Set to 1 to skip model warm-up on startup (faster dev restarts)
TRIGENIX_SKIP_MODEL_WARMUP=0

# Skip heavy GPU tests in pytest
TRIGENIX_SKIP_HEAVY_TESTS=0

# ── Cleanup ───────────────────────────────────────────────────────────────
# Delete generated/ subdirs older than this many days (0 = disabled)
TRIGENIX_CLEANUP_MAX_AGE_DAYS=30

# ── Email notifications (optional) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Database ──────────────────────────────────────────────────────────────
# Default is trigenix.db in the project root
DB_PATH=trigenix.db